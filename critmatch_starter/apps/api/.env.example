# PATCHED (audit fix): this file didn't exist.
# Copy this to .env for local development. See app/core/config.py for
# authoritative parsing.

APP_ENV=development

# --- Frontend / CORS ---
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=

# --- Database ---
DATABASE_URL=postgresql+psycopg://critmatch:critmatch@localhost:5432/critmatch

# --- Session signing ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=critmatch_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SAMESITE=lax

# --- SMART on FHIR ---
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
SMART_ISSUER_ALLOWLIST=https://r4.smarthealthit.org
SMART_REDIRECT_URI=http://localhost:3000/smart/callback
FHIR_BASE_URL=https://r4.smarthealthit.org
# Allowed email domains for first-party login and SMART users with email claims.
LOGIN_EMAIL_DOMAIN_ALLOWLIST=critmatchresearch.com,elionyxhealth.com

# --- Export signing ---
EXPORT_SIGNING_KEY=change-me

# --- MRN hashing ---
MRN_HASH_SALT=change-me

# --- Dev login ---
DEV_LOGIN_ENABLED=0
DEV_LOGIN_ALLOW_PROD=0
DEV_LOGIN_SECRET=
